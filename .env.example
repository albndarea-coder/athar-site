# انسخي هذه القيم إلى متغيرات البيئة في الاستضافة (لا تحفظي القيم الحقيقية في المستودع).

# مجلد البيانات الدائم (قاعدة البيانات والصور). على Railway اربطيه بـ Volume على المسار نفسه.
DATA_DIR=/data

# المنفذ — تضبطه معظم الاستضافات تلقائيًا.
PORT=3000

# بيئة التشغيل (تفعّل ملفات تعريف الارتباط الآمنة).
NODE_ENV=production

# ضعي 1 عند التشغيل خلف وكيل عكسي (Railway وRender وFly وNginx).
TRUST_PROXY=1

# رمز لمرة واحدة لإنشاء حساب المالك من /admin. احذفيه بعد إنشاء الحساب.
# أنشئي قيمة عشوائية طويلة، مثلًا بالأمر: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
SETUP_TOKEN=

# اختياري — لاستعادة وصول المالك إن نُسيت كلمة المرور. اضبطيه مؤقتًا ثم احذفيه.
RECOVERY_TOKEN=

# اختياري — ملح ثابت لتجزئة عناوين IP في سجل الإهداءات (قيمة عشوائية طويلة).
IP_HASH_SALT=
